<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Marketplace</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>
    <main class="container">
      <header class="page-header">
        <div><p class="eyebrow">Royal inventory</p><h1>Magical Artifacts</h1></div>
        <a class="button" href="/artifacts/new">Add Artifact</a>
      </header>

      <% if (artifacts.length === 0) { %>
        <p class="empty">The shelves are empty. Add the first royal artifact.</p>
      <% } %>

      <section class="artifact-grid">
        <% artifacts.forEach((artifact) => { %>
          <article class="artifact-card">
            <div class="artifact-symbol"><%= artifact.image || '🗡️' %></div>
            <span class="rarity"><%= artifact.rarity %></span>
            <h2><%= artifact.name %></h2>
            <p><%= artifact.category %> · <strong><%= artifact.price %> gold</strong></p>
            <a href="/artifacts/<%= artifact._id %>">Inspect artifact →</a>
          </article>
        <% }) %>

      
      </section>
    </main>
  </body>
</html>
